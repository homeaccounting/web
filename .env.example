VITE_API_BASE_URL=http://localhost:8080
# GoatCounter count endpoint (https://<code>.goatcounter.com/count). Image
# builds (CI and `just publish`) default to the production site via the
# Dockerfile ARG. Set this here only to override that default for a local
# build (e.g. a staging site), or to "" to disable analytics in the build.
VITE_GOATCOUNTER_URL=
