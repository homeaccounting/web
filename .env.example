VITE_API_BASE_URL=http://localhost:8080
# Optional: GoatCounter count endpoint (https://<code>.goatcounter.com/count).
# When set (and not on localhost) the app reports scrubbed pageviews. Leave
# empty to disable. Baked into the bundle at build time: `just publish` reads
# it from this env var (loaded via direnv), same as VITE_API_BASE_URL.
VITE_GOATCOUNTER_URL=
